{
  "name": "grade7-vocab-quiz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": ".venv/bin/uvicorn server.main:app --host 0.0.0.0 --port 8000",
    "build": "tsc -b && vite build",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/seed-vocab.mjs",
    "db:import:term": "node scripts/import-grade7-term-vocab.mjs",
    "db:build:all": "node scripts/build-grade7-all-vocab.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "tsc -b --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "pg": "^8.22.0"
  }
}
